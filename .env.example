# --- Murf (needed for `npm run murf:smoke` and /api/murf-test) ---
MURF_API_KEY=
MURF_WS_URL=wss://global.api.murf.ai/v1/speech/stream-input
# Murf's own docs use "falcon-2.1"; Agora's sample uses "FALCON". The smoke check tells you which your key accepts.
MURF_MODEL=falcon-2.1
MURF_VOICE_ID=Gordon
MURF_LOCALE=en-US
# Slightly slower than default for clarity
MURF_RATE=-6
MURF_PITCH=0
MURF_SAMPLE_RATE=24000

# --- Agora (needed for /api/agent/start and /stop) ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Agora Console -> RESTful API -> Customer ID / Secret (Basic auth for the Conversational AI REST API)
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# --- LLM used by the agent (any OpenAI-compatible chat completions endpoint) ---
LLM_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional JSON merged into the LLM request. For DeepSeek use {"thinking":{"type":"disabled"}} so its reasoning is not spoken.
LLM_EXTRA_PARAMS={}

# --- Tool webhooks (Agora calls these from the internet) ---
# Public HTTPS URL of this server, e.g. `ngrok http 3000` -> https://xxxx.ngrok-free.app
PUBLIC_BASE_URL=
# Shared secret sent by Agora in the X-Webhook-Secret header. Generate: openssl rand -hex 24
WEBHOOK_SECRET=

# --- Login for the test page and /api (leave BASIC_AUTH_PASS empty for local-only use; required on Render) ---
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=

PORT=3000
# Supabase: Connect -> "Session pooler" URI, with your database password filled in. Leave empty to use a local database.
DATABASE_URL=
DB_PATH=data/pglite
NURSE_ALERT_LOG=data/nurse-alerts.log
